<UserControl x:Class="InkSlate.App.Controls.PageCanvasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:cel="clr-namespace:InkSlate.Core.Models.CanvasElements;assembly=InkSlate.Core"
             xmlns:vm="clr-namespace:InkSlate.App.ViewModels"
             xmlns:converters="clr-namespace:InkSlate.App.Converters"
             ClipToBounds="True"
             Stylus.IsPressAndHoldEnabled="False"
             Stylus.IsFlicksEnabled="False"
             Stylus.IsTapFeedbackEnabled="False"
             Stylus.IsTouchFeedbackEnabled="False">
    <UserControl.Resources>
        <converters:HexToFrozenBrushConverter x:Key="HexToFrozenBrushConverter" />

        <DropShadowEffect x:Key="MiniBarShadow"
                          BlurRadius="6"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#40000000"
                          Opacity="0.25"
                          RenderingBias="Performance"
                          po:Freeze="True" />

        <Style x:Key="MiniBarButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="#FF1E1E1E" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#20000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InlineTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding ForegroundHex, Converter={StaticResource HexToFrozenBrushConverter}}" />
            <Setter Property="CaretBrush" Value="#FF1E1E1E" />
            <Setter Property="BorderBrush" Value="#FF0078D4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="2"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Focusable="False"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextCanvasElementViewModel Template -->
        <DataTemplate DataType="{x:Type vm:TextCanvasElementViewModel}">
            <Grid Background="Transparent">
                <!-- Floating Mini-Bar Pill (Canvas wrapper allows pill to measure and display at full desired width without being cropped by text element width) -->
                <Canvas VerticalAlignment="Top" HorizontalAlignment="Left" Width="0" Height="0" Canvas.ZIndex="100">
                    <Border x:Name="MiniBarPill"
                            Canvas.Left="0"
                            Canvas.Top="-36"
                            Background="#FFFFFFFF"
                            BorderBrush="#40000000"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="4,2"
                            Visibility="Collapsed"
                            Effect="{StaticResource MiniBarShadow}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Decrease Font Size -->
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding DecreaseFontSizeCommand}"
                                Content="A-"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Width="26"
                                Height="24"
                                Margin="2,0"
                                ToolTip="Decrease Font Size" />
                        <!-- Increase Font Size -->
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding IncreaseFontSizeCommand}"
                                Content="A+"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Width="26"
                                Height="24"
                                Margin="2,0"
                                ToolTip="Increase Font Size" />

                        <Rectangle Width="1" Height="14" Fill="#30000000" Margin="3,0" />

                        <!-- Bold Button -->
                        <Button x:Name="MiniBarBoldButton"
                                Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding ToggleBoldCommand}"
                                Content="B"
                                FontWeight="Bold"
                                Width="24"
                                Height="24"
                                Margin="1,0"
                                ToolTip="Bold" />

                        <!-- Italic Button -->
                        <Button x:Name="MiniBarItalicButton"
                                Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding ToggleItalicCommand}"
                                Content="I"
                                FontStyle="Italic"
                                FontWeight="SemiBold"
                                Width="24"
                                Height="24"
                                Margin="1,0"
                                ToolTip="Italic" />

                        <Rectangle Width="1" Height="14" Fill="#30000000" Margin="3,0" />

                        <!-- Quick Color Swatches with Active Selection Mark -->
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding SetForegroundHexCommand}"
                                CommandParameter="#FF1E1E1E"
                                Width="20" Height="20" Margin="2,0" ToolTip="Charcoal Black">
                            <Grid>
                                <Border x:Name="MiniSwatchBlackRing" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent" />
                                <Ellipse Width="12" Height="12" Fill="#FF1E1E1E" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding SetForegroundHexCommand}"
                                CommandParameter="#FF2563EB"
                                Width="20" Height="20" Margin="2,0" ToolTip="Cobalt Blue">
                            <Grid>
                                <Border x:Name="MiniSwatchBlueRing" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent" />
                                <Ellipse Width="12" Height="12" Fill="#FF2563EB" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding SetForegroundHexCommand}"
                                CommandParameter="#FFDC2626"
                                Width="20" Height="20" Margin="2,0" ToolTip="Crimson Red">
                            <Grid>
                                <Border x:Name="MiniSwatchRedRing" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent" />
                                <Ellipse Width="12" Height="12" Fill="#FFDC2626" />
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding SetForegroundHexCommand}"
                                CommandParameter="#FF16A34A"
                                Width="20" Height="20" Margin="2,0" ToolTip="Emerald Green">
                            <Grid>
                                <Border x:Name="MiniSwatchGreenRing" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="Transparent" />
                                <Ellipse Width="12" Height="12" Fill="#FF16A34A" />
                            </Grid>
                        </Button>

                        <Rectangle Width="1" Height="14" Fill="#30000000" Margin="3,0" />

                        <!-- Delete Button -->
                        <Button Style="{StaticResource MiniBarButtonStyle}"
                                Command="{Binding DeleteCommand}"
                                Width="22" Height="22" Margin="2,0" ToolTip="Delete (Del)">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="13" Foreground="#E02020" />
                        </Button>
                    </StackPanel>
                </Border>
            </Canvas>

                <!-- Static TextBlock (Unfocused / Read-only) -->
                <TextBlock x:Name="StaticTextBlock"
                           Text="{Binding Text}"
                           FontFamily="{Binding FontFamily}"
                           FontSize="{Binding FontSize}"
                           Foreground="{Binding ForegroundHex, Converter={StaticResource HexToFrozenBrushConverter}}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Stretch"
                           IsHitTestVisible="False" />

                <!-- In-Place TextBox with border -->
                <TextBox x:Name="InlineTextBox"
                         Style="{StaticResource InlineTextBoxStyle}"
                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                         FontFamily="{Binding FontFamily}"
                         FontSize="{Binding FontSize}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalAlignment="Stretch"
                         HorizontalAlignment="Stretch"
                         Visibility="Collapsed"
                         IsVisibleChanged="OnInlineTextBoxIsVisibleChanged"
                         LostFocus="OnInlineTextBoxLostFocus" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="MiniBarPill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsEditing}" Value="True">
                    <Setter TargetName="MiniBarPill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StaticTextBlock" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="InlineTextBox" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBold}" Value="True">
                    <Setter TargetName="StaticTextBlock" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="InlineTextBox" Property="FontWeight" Value="Bold" />
                    <Setter TargetName="MiniBarBoldButton" Property="Background" Value="#250078D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsItalic}" Value="True">
                    <Setter TargetName="StaticTextBlock" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="InlineTextBox" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="MiniBarItalicButton" Property="Background" Value="#250078D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ForegroundHex}" Value="#FF1E1E1E">
                    <Setter TargetName="MiniSwatchBlackRing" Property="BorderBrush" Value="#FF0078D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ForegroundHex}" Value="#FF2563EB">
                    <Setter TargetName="MiniSwatchBlueRing" Property="BorderBrush" Value="#FF0078D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ForegroundHex}" Value="#FFDC2626">
                    <Setter TargetName="MiniSwatchRedRing" Property="BorderBrush" Value="#FF0078D4" />
                </DataTrigger>
                <DataTrigger Binding="{Binding ForegroundHex}" Value="#FF16A34A">
                    <Setter TargetName="MiniSwatchGreenRing" Property="BorderBrush" Value="#FF0078D4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ImageCanvasElementViewModel Template -->
        <DataTemplate DataType="{x:Type vm:ImageCanvasElementViewModel}">
            <Grid Background="Transparent">
                <Image Source="{Binding ImageSource}"
                       Stretch="Fill"
                       Clip="{Binding ClipGeometry}" />
                <Border BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#08000000">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ImageSource}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon Symbol="Image24"
                                   FontSize="24"
                                   Foreground="#66000000"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- Fallback Legacy Model Templates -->
        <DataTemplate DataType="{x:Type cel:TextCanvasElement}">
            <TextBlock x:Name="ElementTextBlock"
                       Text="{Binding Text, Mode=OneTime}"
                       FontFamily="{Binding FontFamily, Mode=OneTime}"
                       FontSize="{Binding FontSize, Mode=OneTime}"
                       Foreground="{Binding ForegroundHex, Converter={StaticResource HexToFrozenBrushConverter}, Mode=OneTime}"
                       TextWrapping="Wrap"
                       IsHitTestVisible="False" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsBold, Mode=OneTime}" Value="True">
                    <Setter TargetName="ElementTextBlock" Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsItalic, Mode=OneTime}" Value="True">
                    <Setter TargetName="ElementTextBlock" Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type cel:ImageCanvasElement}">
            <Grid Background="Transparent">
                <Image Source="{Binding DataContext.ImageSource, RelativeSource={RelativeSource AncestorType=ContentControl}}"
                       Stretch="Fill" />
                <Border BorderBrush="#33000000"
                        BorderThickness="1"
                        CornerRadius="4"
                        Background="#08000000">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.ImageSource, RelativeSource={RelativeSource AncestorType=ContentControl}}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <ui:SymbolIcon Symbol="Image24"
                                   FontSize="24"
                                   Foreground="#66000000"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid"
          ClipToBounds="True"
          Background="Transparent">
        <InkCanvas x:Name="InternalInkCanvas"
                   Background="Transparent"
                   ClipToBounds="True"
                   Stylus.IsPressAndHoldEnabled="False"
                   Stylus.IsFlicksEnabled="False"
                   Stylus.IsTapFeedbackEnabled="False"
                   Stylus.IsTouchFeedbackEnabled="False" />
        <Canvas x:Name="CursorOverlayCanvas"
                IsHitTestVisible="False"
                ClipToBounds="True">
            <Ellipse x:Name="EraserCursorIndicator"
                     IsHitTestVisible="False"
                     Visibility="Collapsed"
                     Stroke="#801E1E1E"
                     StrokeThickness="1"
                     Fill="#141E1E1E" />
        </Canvas>
    </Grid>
</UserControl>
