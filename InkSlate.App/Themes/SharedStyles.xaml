<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:models="clr-namespace:InkSlate.Core.Models;assembly=InkSlate.Core"
                    xmlns:converters="clr-namespace:InkSlate.App.Converters">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:HexToFrozenBrushConverter x:Key="HexToFrozenBrushConverter" />

    <DropShadowEffect x:Key="FloatingSurfaceShadow"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.22"
                      po:Freeze="True" />

    <DropShadowEffect x:Key="PageSheetShadow"
                      BlurRadius="8"
                      ShadowDepth="2"
                      Direction="270"
                      Color="#000000"
                      Opacity="0.16"
                      po:Freeze="True" />

    <SolidColorBrush x:Key="PageBorderBrush"
                     Color="#1A000000"
                     po:Freeze="True" />

    <SolidColorBrush x:Key="ToolbarSolidBackgroundBrush"
                     Color="#FF242424"
                     po:Freeze="True" />

    <SolidColorBrush x:Key="ToolbarSolidBorderBrush"
                     Color="#FF3D3D3D"
                     po:Freeze="True" />

    <Style x:Key="ToolbarIconButtonStyle" TargetType="ui:Button">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="ToolbarToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="0,6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PresetPillButtonStyle" TargetType="ui:Button">
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Appearance" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style x:Key="SubtoolStackPanelStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                <Setter Property="Orientation" Value="Vertical" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SubtoolSeparatorStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ToolbarSolidBorderBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="6,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="1" />
                <Setter Property="Margin" Value="2,6" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PopoverContainerStyle" TargetType="Border">
        <Setter Property="Grid.Row" Value="0" />
        <Setter Property="Grid.RowSpan" Value="2" />
        <Setter Property="Grid.Column" Value="0" />
        <Setter Property="Grid.ColumnSpan" Value="2" />
        <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,48,0,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="48,70,0,0" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,52,0,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
