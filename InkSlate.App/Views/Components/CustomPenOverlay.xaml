<UserControl x:Class="InkSlate.App.Views.Components.CustomPenOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:InkSlate.App.ViewModels">
    <Grid>
        <!-- Right-Side Custom Pen Dock (Visible only when custom pens are defined) -->
        <Border x:Name="CustomPenRightDock"
                Margin="0,0,16,0"
                Padding="4,6"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Background="{StaticResource ToolbarSolidBackgroundBrush}"
                BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource FloatingSurfaceShadow}"
                Visibility="{Binding Toolbar.HasCustomPenPresets, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                <ItemsControl x:Name="CustomPenRightDockItemsControl"
                              ItemsSource="{Binding Toolbar.CustomPenPresets}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:CustomPenPresetViewModel}">
                            <Button Width="36"
                                    Height="36"
                                    Margin="0,2"
                                    Padding="0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.Toolbar.ActivateCustomPenCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                    CommandParameter="{Binding}"
                                    MouseRightButtonUp="CustomPenPresetButton_MouseRightButtonUp"
                                    ToolTip="{Binding TooltipText}">
                                <Grid>
                                    <!-- Selection Ring -->
                                    <Border x:Name="SelectionRing"
                                            Width="34"
                                            Height="34"
                                            CornerRadius="8"
                                            BorderThickness="2"
                                            BorderBrush="Transparent" />

                                    <!-- Pen Color & Thickness Preview Dot -->
                                    <Ellipse Width="{Binding DotDiameter}"
                                             Height="{Binding DotDiameter}"
                                             Fill="{Binding FrozenBrush}"
                                             Stroke="#33000000"
                                             StrokeThickness="1"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />

                                    <!-- Shortcut Badge Overlay -->
                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="3"
                                            Padding="2,0"
                                            Height="12"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Bottom"
                                            Margin="0,0,1,1"
                                            Visibility="{Binding HasShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Shortcut}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="SelectionRing" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="2,4" />

                <!-- Add New Custom Pen Preset Button -->
                <ui:Button x:Name="AddCustomPenDockButton"
                           Command="{Binding Toolbar.OpenNewCustomPenEditorCommand}"
                           Width="32"
                           Height="32"
                           Padding="0"
                           Margin="0,1"
                           ToolTip="Add Custom Pen Preset"
                           Style="{StaticResource ToolbarIconButtonStyle}">
                    <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- Custom Pen Preset Editor Popover / Dialog -->
        <Border x:Name="CustomPenEditorPopover"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,0,72,0"
                Width="280"
                Padding="14,12"
                Background="{StaticResource ToolbarSolidBackgroundBrush}"
                BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource FloatingSurfaceShadow}"
                Visibility="{Binding Toolbar.IsCustomPenEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Vertical">
                <!-- Header -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="Custom Pen Preset"
                               FontWeight="SemiBold"
                               FontSize="13"
                               VerticalAlignment="Center" />

                    <!-- Live Preview Dot -->
                    <Ellipse Grid.Column="1"
                             Width="{Binding Toolbar.CustomPenEditorPreviewDiameter}"
                             Height="{Binding Toolbar.CustomPenEditorPreviewDiameter}"
                             Fill="{Binding Toolbar.CustomPenEditorPreviewBrush}"
                             Stroke="#33000000"
                             StrokeThickness="1"
                             Margin="8,0"
                             VerticalAlignment="Center" />

                    <ui:Button Grid.Column="2"
                               Command="{Binding Toolbar.CloseCustomPenEditorCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Width="24"
                               Height="24"
                               Padding="0"
                               ToolTip="Close (Esc)">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                    </ui:Button>
                </Grid>

                <!-- Name Input -->
                <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,4" />
                <TextBox x:Name="CustomPenNameTextBox"
                         Text="{Binding Toolbar.CustomPenEditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         Height="28"
                         FontSize="12"
                         Padding="6,3"
                         MaxLength="64"
                         VerticalContentAlignment="Center"
                         Margin="0,0,0,8" />

                <!-- Color Swatches Grid -->
                <TextBlock Text="Color" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,4" />
                <ItemsControl ItemsSource="{Binding Toolbar.ColorSwatches}" Margin="0,0,0,6">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                            <Button Width="24"
                                    Height="24"
                                    Margin="2"
                                    Padding="0"
                                    Cursor="Hand"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding DataContext.Toolbar.SelectCustomPenEditorColorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                    CommandParameter="{Binding Hex}"
                                    ToolTip="{Binding Hex}">
                                <Grid>
                                    <Border x:Name="SelectionRing"
                                            Width="22"
                                            Height="22"
                                            CornerRadius="11"
                                            BorderThickness="2"
                                            BorderBrush="Transparent" />
                                    <Ellipse Width="16"
                                             Height="16"
                                             Fill="{Binding FrozenBrush}"
                                             Stroke="#33000000"
                                             StrokeThickness="1" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Thickness Slider -->
                <Grid Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Thickness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Toolbar.CustomPenEditorThickness, StringFormat='{}{0:0.0} px'}" FontSize="11" FontWeight="Bold" />
                </Grid>
                <Slider Minimum="0.5"
                        Maximum="24.0"
                        Value="{Binding Toolbar.CustomPenEditorThickness, Mode=TwoWay}"
                        Margin="0,0,0,8" />

                <!-- Shortcut Key Input -->
                <TextBlock Text="Shortcut (e.g. 1, 2, Shift+R, Alt+1)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,4" />
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomPenShortcutTextBox"
                             Grid.Column="0"
                             Text="{Binding Toolbar.CustomPenEditorShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             PreviewKeyDown="CustomPenShortcutTextBox_PreviewKeyDown"
                             Height="28"
                             FontSize="12"
                             FontFamily="Consolas"
                             FontWeight="SemiBold"
                             Padding="6,3"
                             MaxLength="32"
                             VerticalContentAlignment="Center"
                             ToolTip="Press key combination or type shortcut" />
                    <ui:Button Grid.Column="1"
                               Command="{Binding Toolbar.ClearCustomPenEditorShortcutCommand}"
                               Content="Clear"
                               Height="28"
                               Margin="6,0,0,0"
                               Padding="8,0"
                               FontSize="11" />
                </Grid>

                <!-- Shortcut Error Message (if any) -->
                <TextBlock Text="{Binding Toolbar.CustomPenEditorShortcutError}"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"
                           Visibility="{Binding Toolbar.HasCustomPenEditorShortcutError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- Action Buttons -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Delete Button (Only when editing existing) -->
                    <ui:Button x:Name="DeleteCustomPenButton"
                               Grid.Column="0"
                               Command="{Binding Toolbar.DeleteCustomPenPresetCommand}"
                               Content="Delete"
                               FontSize="11"
                               Height="28"
                               Padding="10,0"
                               Foreground="#E02020"
                               Visibility="{Binding Toolbar.IsEditingExistingCustomPen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Save & Use Button -->
                    <ui:Button x:Name="SaveCustomPenButton"
                               Grid.Column="1"
                               Command="{Binding Toolbar.SaveCustomPenPresetCommand}"
                               Content="Save &amp; Use"
                               Appearance="Primary"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Height="28"
                               HorizontalAlignment="Right"
                               Padding="14,0" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

