<UserControl x:Class="InkSlate.App.Views.Components.HelpShortcutsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- Help & Keyboard Shortcuts Modal Dialog Overlay -->
    <Grid x:Name="HelpDialogOverlay"
          Panel.ZIndex="100"
          Background="#7F000000"
          Visibility="{Binding IsHelpOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
          MouseLeftButtonDown="HelpDialogBackdrop_MouseLeftButtonDown">

        <!-- Dialog Card -->
        <Border x:Name="HelpDialogCard"
                Width="620"
                MaxHeight="560"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource ToolbarSolidBackgroundBrush}"
                BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,20"
                Effect="{StaticResource FloatingSurfaceShadow}"
                MouseLeftButtonDown="HelpDialogCard_MouseLeftButtonDown">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="QuestionCircle24"
                                       FontSize="20"
                                       Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center" />
                        <TextBlock Text="Help &amp; Keyboard Shortcuts"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <ui:Button x:Name="CloseHelpDialogButton"
                               Grid.Column="1"
                               Command="{Binding CloseHelpCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Close (Esc)">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                    </ui:Button>
                </Grid>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="0,0,0,16"
                        Background="{StaticResource ToolbarSolidBorderBrush}" />

                <!-- Shortcuts Two-Column Grid -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Column 1: Tools & Inking -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="TOOLS &amp; DRAWING"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="V" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Pointer (Select &amp; Pan)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="P" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Pen Tool" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="H" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Highlighter Tool" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Eraser (Cycle modes)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="L" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Lasso (Cycle filters)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="T" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Insert Text Box" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                    <TextBlock Text="I" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Insert Image" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Space (Hold)" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Temporary Pan Mode" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="1–9 / Custom" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Activate Custom Pen" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>
                        </StackPanel>

                        <!-- Column 2: Document, Navigation & Editing -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="DOCUMENT &amp; SHORTCUTS"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Margin="0,0,0,8" />

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="2x Click / F2" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Rename Document Title" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Ctrl + N / O / S" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="New / Open / Save" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Ctrl + E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Export Vector PDF" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Ctrl + C / V" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Copy / Paste Object" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Ctrl + Z / Y" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Undo / Redo" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Del / Backspace" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Delete Selected Item" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Ctrl + Enter" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Add New Page" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="PgUp / PgDn" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Previous / Next Page" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="F5 / F11" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Toggle View / Fullscreen" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                    <TextBlock Text="Ctrl + 0" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="Reset Zoom (100%)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>

