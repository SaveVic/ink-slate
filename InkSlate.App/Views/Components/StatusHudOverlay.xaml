<UserControl x:Class="InkSlate.App.Views.Components.StatusHudOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <!-- Bottom-Left PDF Export Progress / Status Pill -->
        <Border x:Name="ExportStatusPill"
                Margin="16"
                Padding="12,6"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="{StaticResource ToolbarSolidBackgroundBrush}"
                BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource FloatingSurfaceShadow}"
                Visibility="{Binding IsExportStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <!-- In-Progress State -->
                <StackPanel x:Name="ExportInProgressPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExportCompleted}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="Exporting PDF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ProgressBar x:Name="ExportProgressBar"
                                 Width="120"
                                 Height="6"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ExportProgressPercentage}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                    <TextBlock x:Name="ExportProgressText"
                               Text="{Binding ExportProgressPercentage, StringFormat={}{0:0}%}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               VerticalAlignment="Center"
                               MinWidth="30"
                               TextAlignment="Right" />
                </StackPanel>

                <!-- Completed State -->
                <StackPanel x:Name="ExportCompletedPanel"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExportCompleted}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Foreground="#107C41" Margin="0,0,8,0" />
                    <TextBlock x:Name="ExportFinishedText"
                               Text="{Binding ExportStatusMessage, FallbackValue='Export finished'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Close / Dismiss Button -->
                <ui:Button x:Name="DismissExportStatusButton"
                           Command="{Binding DismissExportStatusCommand}"
                           Width="20"
                           Height="20"
                           Padding="0"
                           CornerRadius="4"
                           Margin="8,0,0,0"
                           Appearance="Transparent"
                           ToolTip="Dismiss">
                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" />
                </ui:Button>
            </StackPanel>
        </Border>

        <!-- Bottom-Right Minimalist Corner HUD Pill -->
        <Border x:Name="CornerHudPill"
                Margin="16"
                Padding="10,4"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Background="{StaticResource ToolbarSolidBackgroundBrush}"
                BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Effect="{StaticResource FloatingSurfaceShadow}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="PreviousPageButton"
                           Command="{Binding PreviousPageCommand}"
                           Width="24"
                           Height="24"
                           Padding="0"
                           CornerRadius="6"
                           Appearance="Transparent"
                           ToolTip="Previous Page (PageUp)">
                    <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                </ui:Button>

                <TextBlock x:Name="PageIndicatorText"
                           Margin="8,0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Text="{Binding PageIndicatorDisplay, FallbackValue='1 / 1'}" />

                <ui:Button x:Name="NextPageButton"
                           Command="{Binding NextPageCommand}"
                           Width="24"
                           Height="24"
                           Padding="0"
                           CornerRadius="6"
                           Appearance="Transparent"
                           ToolTip="Next Page (PageDown)">
                    <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" />
                </ui:Button>

                <Border Width="1"
                        Height="14"
                        Margin="8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                <ui:Button x:Name="ResetZoomButton"
                           Command="{Binding ResetZoomCommand}"
                           Height="24"
                           Padding="6,0"
                           CornerRadius="6"
                           Appearance="Transparent"
                           Content="{Binding ZoomPercentageDisplay, FallbackValue='100%'}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           ToolTip="Reset Zoom (Ctrl+0)" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

