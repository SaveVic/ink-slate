<ui:FluentWindow x:Class="InkSlate.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:InkSlate.Core.Models;assembly=InkSlate.Core"
                 xmlns:controls="clr-namespace:InkSlate.App.Controls"
                 xmlns:vm="clr-namespace:InkSlate.App.ViewModels"
                 xmlns:converters="clr-namespace:InkSlate.App.Converters"
                 Title="{Binding WindowTitleDisplay, FallbackValue=InkSlate}"
                 Width="1280"
                 Height="800"
                 MinWidth="720"
                 MinHeight="480"
                 WindowState="Maximized"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 Icon="pack://application:,,,/InkSlate.App;component/Assets/inkslate.ico"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:HexToFrozenBrushConverter x:Key="HexToFrozenBrushConverter" />

        <DropShadowEffect x:Key="FloatingSurfaceShadow"
                          BlurRadius="14"
                          ShadowDepth="3"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.22"
                          po:Freeze="True" />

        <DropShadowEffect x:Key="PageSheetShadow"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.16"
                          po:Freeze="True" />

        <SolidColorBrush x:Key="PageBorderBrush"
                         Color="#1A000000"
                         po:Freeze="True" />

        <DataTemplate x:Key="PageSheetDataTemplate">
            <StackPanel Width="{Binding Width}"
                        Margin="0,0,0,24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top">
                <!-- Page Header: Top Left "Page {no}", Top Right Delete Button -->
                <Grid Margin="2,0,2,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Top Left: "Page {no}" -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding PageNumber, StringFormat='Page {0}'}"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <!-- Top Right: Delete Button to Remove Page -->
                    <ui:Button Grid.Column="1"
                               Command="{Binding DataContext.DeleteSpecificPageCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                               CommandParameter="{Binding}"
                               Visibility="{Binding DataContext.CanDeletePages, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Width="26"
                               Height="26"
                               Padding="0"
                               Appearance="Transparent"
                               ToolTip="Delete Page"
                               Cursor="Hand">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#D13438" />
                    </ui:Button>
                </Grid>

                <!-- Page Sheet Paper -->
                <Border Width="{Binding Width}"
                        Height="{Binding Height}"
                        ClipToBounds="True"
                        Background="{Binding BackgroundHex, Converter={StaticResource HexToFrozenBrushConverter}, FallbackValue=#FFFFFFFF}"
                        BorderBrush="{StaticResource PageBorderBrush}"
                        BorderThickness="1"
                        Effect="{StaticResource PageSheetShadow}">
                    <controls:PageCanvasControl PageId="{Binding Id}"
                                                PageStrokes="{Binding Strokes, Mode=TwoWay}"
                                                SelectedStrokes="{Binding SelectedStrokes, Mode=TwoWay}"
                                                UndoRedoManager="{Binding UndoRedo}"
                                                IsPageDirty="{Binding IsDirty, Mode=TwoWay}"
                                                InkDrawingAttributes="{Binding Toolbar.CurrentDrawingAttributes}"
                                                ActiveToolMode="{Binding Toolbar.ActiveTool, FallbackValue={x:Static models:ToolMode.Pointer}}"
                                                ActiveEraserMode="{Binding Toolbar.SelectedEraserMode, FallbackValue={x:Static models:EraserMode.Stroke}}"
                                                EraserSize="{Binding Toolbar.SelectedEraserSize, FallbackValue=16.0}"
                                                ActiveLassoFilterMode="{Binding Toolbar.SelectedLassoFilterMode, FallbackValue={x:Static models:LassoFilterMode.AllObjects}}"
                                                PageElements="{Binding Elements}"
                                                RemoveElementCommand="{Binding RemoveElementCommand}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ToolbarToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="0,6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetPillButtonStyle" TargetType="ui:Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <SolidColorBrush x:Key="ToolbarSolidBackgroundBrush" Color="#FF242424" po:Freeze="True" />
        <SolidColorBrush x:Key="ToolbarSolidBorderBrush" Color="#FF3D3D3D" po:Freeze="True" />

        <Style x:Key="SubtoolStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtoolSeparatorStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToolbarSolidBorderBrush}" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="2,6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopoverContainerStyle" TargetType="Border">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,48,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="48,70,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="0,52,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TitleBar & Window Header -->
        <Grid Grid.Row="0">
            <ui:TitleBar ShowMinimize="True"
                         ShowMaximize="True"
                         ShowClose="True"
                         ShowHelp="False" />
        </Grid>

        <!-- Main Workspace Layer -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Viewport Region (Dual View Modes: Consecutive & Separated) -->
            <Border x:Name="ViewportRegion"
                    Background="Transparent"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: TopDocked (Row 1, Column 0 Span 2) -->
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:ZoomScrollViewer x:Name="ViewportScrollViewer"
                                           ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                           CurrentViewMode="{Binding CurrentViewMode}"
                                           ActiveToolMode="{Binding Toolbar.ActiveTool}"
                                           PreviousPageCommand="{Binding PreviousPageCommand}"
                                           NextPageCommand="{Binding NextPageCommand}"
                                           Background="Transparent">
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,24,0,32" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                        <Setter Property="Margin" Value="0,60,0,32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Consecutive View: Virtualized Continuous Vertical Stack -->
                        <ItemsControl x:Name="ConsecutivePagesControl"
                                      ItemsSource="{Binding Pages}"
                                      ItemTemplate="{StaticResource PageSheetDataTemplate}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="1,1"
                                      VirtualizingPanel.CacheLengthUnit="Page"
                                      Visibility="{Binding IsConsecutiveView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsVirtualizing="True"
                                                            VirtualizationMode="Recycling"
                                                            ScrollUnit="Pixel"
                                                            CacheLength="1,1"
                                                            CacheLengthUnit="Page"
                                                            HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Separated View: Single-Page Presentation Focus Mode -->
                        <ContentControl x:Name="SeparatedPageHost"
                                        Content="{Binding ActivePage}"
                                        ContentTemplate="{StaticResource PageSheetDataTemplate}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsSeparatedView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </controls:ZoomScrollViewer>
            </Border>

            <!-- Command Bar (Top Docked, Left Docked Sidebar, or Top Floating) -->
            <Border x:Name="FloatingCommandBar">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: TopDocked -->
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Effect" Value="{x:Null}" />
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="4,8" />
                                <Setter Property="Effect" Value="{x:Null}" />
                                <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,8,0,0" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
                                <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                    <Setter Property="Orientation" Value="Vertical" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- File & Export -->
                    <ui:Button x:Name="NewDocumentButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Command="{Binding NewDocumentCommand}"
                               ToolTip="New Document (Ctrl+N)">
                        <ui:SymbolIcon Symbol="Document24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="OpenButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Command="{Binding OpenCommand}"
                               ToolTip="Open (Ctrl+O)">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="SaveButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Command="{Binding SaveCommand}"
                               ToolTip="Save (Ctrl+S)">
                        <ui:SymbolIcon Symbol="Save24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ExportPdfButton"
                               Command="{Binding TogglePdfExportCommand}"
                               ToolTip="Export PDF (Ctrl+E)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportOpen}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Canvas Tools -->
                    <ui:Button x:Name="PointerToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Pointer}"
                               ToolTip="Pointer / Select &amp; Pan (V)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsPointerToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Cursor24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="PenToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Pen}"
                               ToolTip="Pen (P)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsPenToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Pen24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="HighlighterToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Highlighter}"
                               ToolTip="Highlighter (H)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsHighlighterToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Highlight24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="EraserToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Eraser}"
                               ToolTip="Eraser (E)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsEraserToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Eraser24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="LassoToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Lasso}"
                               ToolTip="Lasso (L)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Lasso24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="TextToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Text}"
                               ToolTip="Text (T)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsTextToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="TextFont24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ImageToolButton"
                               Command="{Binding InsertImageCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Image (I)">
                        <ui:SymbolIcon Symbol="Image24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Undo / Redo -->
                    <ui:Button x:Name="UndoButton"
                               Command="{Binding UndoCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Undo (Ctrl+Z)">
                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="RedoButton"
                               Command="{Binding RedoCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Redo (Ctrl+Y)">
                        <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Page & View Management -->
                    <ui:Button x:Name="AddPageButton"
                               Command="{Binding AddPageCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Add Page (Ctrl+Enter)">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="PageSetupButton"
                               Command="{Binding TogglePageSetupCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Page Setup">
                        <ui:SymbolIcon Symbol="PageFit24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ToggleViewModeButton"
                               Command="{Binding ToggleViewModeCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Toggle View: Consecutive / Separated (F5)">
                        <ui:SymbolIcon Symbol="SlideMultiple24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Toolbar Placement Cycle Button -->
                    <ui:Button x:Name="CyclePlacementButton"
                               Command="{Binding Toolbar.CyclePlacementCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Cycle Toolbar Position: Fixed Top / Left Sidebar / Floating">
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="18" />
                    </ui:Button>

                    <!-- Help & Keyboard Shortcuts Button -->
                    <ui:Button x:Name="HelpButton"
                               Command="{Binding ToggleHelpCommand}"
                               ToolTip="Help &amp; Shortcuts (F1)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHelpOpen}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Document Title Header Bar (Repositioned from TopBar to Workspace Header) -->
            <Border x:Name="DocumentTitleHeaderBar">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: TopDocked (Row 0, Column 0 Span 2, Left-aligned inside top bar) -->
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="HorizontalAlignment" Value="Left" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="14,0,0,0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="CornerRadius" Value="6" />
                        <Setter Property="Padding" Value="4,2" />
                        <Setter Property="Effect" Value="{x:Null}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="1" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="16,12,0,0" />
                                <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="16,10,0,0" />
                                <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Padding" Value="8,4" />
                                <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Title Container (Interactive) -->
                    <Grid x:Name="TitleContainer" VerticalAlignment="Center">
                        <!-- Display Mode Pill -->
                        <Border x:Name="TitleDisplayPill"
                                Cursor="Hand"
                                CornerRadius="4"
                                Padding="8,3"
                                ToolTip="Double-click to edit document title (F2)"
                                MouseLeftButtonDown="TitleDisplayPill_MouseLeftButtonDown">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Document Title -->
                                <TextBlock Text="{Binding DocumentTitle}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                                <ui:SymbolIcon Symbol="Edit16"
                                               FontSize="11"
                                               Margin="6,0,0,0"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Edit Mode Container -->
                        <Grid x:Name="TitleEditContainer" VerticalAlignment="Center">
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditingTitle}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="TitleEditTextBox"
                                         Text="{Binding TitleDraft, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="12"
                                         FontWeight="SemiBold"
                                         MinWidth="90"
                                         MaxWidth="280"
                                         Height="26"
                                         Padding="6,2"
                                         VerticalContentAlignment="Center"
                                         VerticalAlignment="Center"
                                         IsVisibleChanged="TitleEditTextBox_IsVisibleChanged"
                                         KeyDown="TitleEditTextBox_KeyDown"
                                         LostFocus="TitleEditTextBox_LostFocus" />

                                <ui:Button Command="{Binding CommitTitleEditCommand}"
                                           ToolTip="Apply Title (Enter)"
                                           Width="24"
                                           Height="24"
                                           Margin="3,0,0,0"
                                           Padding="0"
                                           Appearance="Transparent"
                                           Cursor="Hand"
                                           VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="12" Foreground="#107C41" />
                                </ui:Button>

                                <ui:Button Command="{Binding CancelTitleEditCommand}"
                                           ToolTip="Cancel (Esc)"
                                           Width="24"
                                           Height="24"
                                           Margin="2,0,0,0"
                                           Padding="0"
                                           Appearance="Transparent"
                                           Cursor="Hand"
                                           VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#D13438" />
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Grid>

                    <!-- Dash separator -->
                    <TextBlock Text="—"
                               Margin="6,0"
                               FontSize="11"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                               VerticalAlignment="Center" />

                    <!-- Saved / Unsaved Status Indicator Badge -->
                    <Border CornerRadius="4"
                            Padding="6,1.5"
                            VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#18D13438" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                        <Setter Property="Background" Value="#18107C41" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Status Glyph Dot -->
                            <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#D13438" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter Property="Fill" Value="#107C41" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>

                            <!-- Status Text -->
                            <TextBlock Text="{Binding SaveStatusDisplay}"
                                       FontSize="11"
                                       FontWeight="Medium"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#D13438" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter Property="Foreground" Value="#107C41" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Compact Pen Options Popover -->
            <Border x:Name="PenOptionsPopover"
                    Padding="10,6"
                    Visibility="{Binding Toolbar.IsPenOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,140,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Vertical">
                    <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                        <!-- Color Swatches (Curated + User Custom) -->
                        <ItemsControl x:Name="ColorSwatchesItemsControl"
                                      ItemsSource="{Binding Toolbar.ColorSwatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                    <Button Width="26"
                                            Height="26"
                                            Margin="2"
                                            Padding="0"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.Toolbar.SelectColorSwatchCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding Hex}"
                                            MouseRightButtonUp="ColorSwatchButton_MouseRightButtonUp">
                                        <Button.ToolTip>
                                            <ToolTip Content="{Binding Hex}" />
                                        </Button.ToolTip>
                                        <Grid>
                                            <Border x:Name="SelectionRing"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="12"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent" />
                                            <Ellipse Width="18"
                                                     Height="18"
                                                     Fill="{Binding FrozenBrush}"
                                                     Stroke="#33000000"
                                                     StrokeThickness="1" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Custom Color Button -->
                        <ui:Button x:Name="AddCustomPenColorButton"
                                   Command="{Binding Toolbar.ToggleCustomColorPickerCommand}"
                                   Width="26"
                                   Height="26"
                                   Margin="2"
                                   Padding="0"
                                   ToolTip="Custom Color (RGB / Hex / Palette)"
                                   Style="{StaticResource ToolbarIconButtonStyle}">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                        </ui:Button>

                        <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                        <!-- 4 Thickness Dots (Zero text labels) -->
                        <ItemsControl x:Name="ThicknessDotsItemsControl"
                                      ItemsSource="{Binding Toolbar.ThicknessOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThicknessOption}">
                                    <Button Width="26"
                                            Height="26"
                                            Margin="2"
                                            Padding="0"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.Toolbar.SelectPenThicknessCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding ThicknessDip}">
                                        <Grid>
                                            <Border x:Name="SelectionRing"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="12"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent" />
                                            <Ellipse x:Name="Dot"
                                                     Width="{Binding DotDiameter}"
                                                     Height="{Binding DotDiameter}"
                                                     Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                        <!-- Save / Create Custom Pen Preset Button -->
                        <ui:Button x:Name="AddCustomPenFromOptionsButton"
                                   Command="{Binding Toolbar.OpenNewCustomPenEditorCommand}"
                                   Width="26"
                                   Height="26"
                                   Margin="2"
                                   Padding="0"
                                   ToolTip="Save as Custom Pen Preset"
                                   Style="{StaticResource ToolbarIconButtonStyle}">
                            <ui:SymbolIcon Symbol="StarAdd24" FontSize="14" />
                        </ui:Button>
                    </StackPanel>

                    <!-- Collapsible Custom Color Picker Panel -->
                    <Border x:Name="PenCustomColorPickerPanel"
                            Margin="0,8,0,2"
                            Padding="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{Binding Toolbar.IsCustomColorPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="256">
                        <StackPanel Orientation="Vertical">
                            <!-- 1. Interactive 2D Color Spectrum Box (Saturation & Value) -->
                            <Border x:Name="PenColorSpectrumBox"
                                    Height="90"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    Cursor="Cross"
                                    Background="{Binding Toolbar.CustomHueBaseBrush}"
                                    MouseLeftButtonDown="ColorSpectrumBox_MouseLeftButtonDown"
                                    MouseMove="ColorSpectrumBox_MouseMove"
                                    MouseLeftButtonUp="ColorSpectrumBox_MouseLeftButtonUp">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- Hue Slider (0-360) with Rainbow Gradient -->
                            <Grid Margin="0,6,0,6">
                                <Border Height="8" CornerRadius="4" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FFFF0000" Offset="0.0" />
                                            <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                            <GradientStop Color="#FF00FF00" Offset="0.33" />
                                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                            <GradientStop Color="#FF0000FF" Offset="0.67" />
                                            <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                            <GradientStop Color="#FFFF0000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Slider Minimum="0"
                                        Maximum="360"
                                        Value="{Binding Toolbar.CustomColorHue, Mode=TwoWay}"
                                        Opacity="0.85"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <!-- 2. 24 Quick Spectrum Palette Grid -->
                            <ItemsControl ItemsSource="{x:Static vm:ToolbarViewModel.PaletteGridSwatches}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                        <Button Width="24"
                                                Height="18"
                                                Margin="1"
                                                Padding="0"
                                                Cursor="Hand"
                                                Background="{Binding FrozenBrush}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.Toolbar.PickPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="0.5" BorderBrush="#33000000" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 3. RGB Sliders and Numeric Inputs -->
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- R -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#FFEF4444" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Toolbar.CustomColorR, Mode=TwoWay}" Margin="6,1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Toolbar.CustomColorR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2,1" Height="20" HorizontalContentAlignment="Center" VerticalAlignment="Center" />

                                <!-- G -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#FF22C55E" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Toolbar.CustomColorG, Mode=TwoWay}" Margin="6,1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Toolbar.CustomColorG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2,1" Height="20" HorizontalContentAlignment="Center" VerticalAlignment="Center" />

                                <!-- B -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#FF3B82F6" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Toolbar.CustomColorB, Mode=TwoWay}" Margin="6,1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Toolbar.CustomColorB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2,1" Height="20" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 4. Hex Input, Live Preview, and Add & Use Button -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Live Preview -->
                                <Ellipse Grid.Column="0" Width="24" Height="24" Fill="{Binding Toolbar.CustomColorPreviewBrush}" Stroke="#44000000" StrokeThickness="1" />

                                <!-- Hex Input -->
                                <TextBox Grid.Column="2"
                                         Text="{Binding Toolbar.CustomColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Height="26"
                                         MaxLength="9"
                                         ToolTip="Hex Color Code (#RRGGBB)" />

                                <!-- Add & Use Button -->
                                <ui:Button Grid.Column="4"
                                           Command="{Binding Toolbar.AddCustomColorCommand}"
                                           Content="Add &amp; Use"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Appearance="Primary"
                                           Height="26"
                                           Padding="4,0"
                                           HorizontalAlignment="Stretch"
                                           ToolTip="Add to custom swatches and apply" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Compact Eraser Options Popover -->
            <Border x:Name="EraserOptionsPopover"
                    Padding="10,6"
                    Visibility="{Binding Toolbar.IsEraserOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,210,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- 3-Mode Segmented Eraser Buttons -->
                    <ui:Button x:Name="StrokeEraserModeButton"
                               Command="{Binding Toolbar.SelectEraserModeCommand}"
                               CommandParameter="{x:Static models:EraserMode.Stroke}"
                               ToolTip="Stroke Eraser">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsStrokeEraserMode}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Eraser24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="PointEraserModeButton"
                               Command="{Binding Toolbar.SelectEraserModeCommand}"
                               CommandParameter="{x:Static models:EraserMode.Point}"
                               ToolTip="Point Eraser">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsPointEraserMode}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="CircleSmall24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="ObjectEraserModeButton"
                               Command="{Binding Toolbar.SelectEraserModeCommand}"
                               CommandParameter="{x:Static models:EraserMode.Object}"
                               ToolTip="Object Eraser">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsObjectEraserMode}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Shapes24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- 3 Eraser Size Dots (Zero text labels) -->
                    <ItemsControl x:Name="EraserSizeDotsItemsControl"
                                  ItemsSource="{Binding Toolbar.EraserSizeOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EraserSizeOption}">
                                <Button Width="26"
                                        Height="26"
                                        Margin="2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.SelectEraserSizeCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding SizeDip}">
                                    <Grid>
                                        <Border x:Name="SelectionRing"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />
                                        <Ellipse x:Name="Dot"
                                                 Width="{Binding DotDiameter}"
                                                 Height="{Binding DotDiameter}"
                                                 Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Compact Lasso Options Popover -->
            <Border x:Name="LassoOptionsPopover"
                    Padding="6,4"
                    Visibility="{Binding Toolbar.IsLassoOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,245,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <ui:Button x:Name="LassoStrokesOnlyButton"
                               Command="{Binding Toolbar.SelectLassoFilterCommand}"
                               CommandParameter="{x:Static models:LassoFilterMode.StrokesOnly}"
                               ToolTip="Strokes Only">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoStrokesOnly}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Pen24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="LassoElementsOnlyButton"
                               Command="{Binding Toolbar.SelectLassoFilterCommand}"
                               CommandParameter="{x:Static models:LassoFilterMode.ElementsOnly}"
                               ToolTip="Elements Only">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoElementsOnly}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Shapes24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="LassoAllObjectsButton"
                               Command="{Binding Toolbar.SelectLassoFilterCommand}"
                               CommandParameter="{x:Static models:LassoFilterMode.AllObjects}"
                               ToolTip="All Objects">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoAllObjects}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="SlideMultiple24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Compact Text Options Popover -->
            <Border x:Name="TextOptionsPopover"
                    Padding="8,6"
                    Visibility="{Binding Toolbar.IsTextOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,280,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Vertical">
                    <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                        <!-- Decrease Font Size -->
                        <ui:Button Command="{Binding Toolbar.DecreaseTextFontSizeCommand}"
                                   Content="A-"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Width="28"
                                   Height="28"
                                   Margin="2,0"
                                   Padding="0"
                                   Appearance="Transparent"
                                   ToolTip="Decrease Font Size" />

                        <!-- Font Size Display -->
                        <TextBlock Text="{Binding Toolbar.SelectedTextFontSize, StringFormat={}{0:0}}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Width="22"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                        <!-- Increase Font Size -->
                        <ui:Button Command="{Binding Toolbar.IncreaseTextFontSizeCommand}"
                                   Content="A+"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Width="28"
                                   Height="28"
                                   Margin="2,0"
                                   Padding="0"
                                   Appearance="Transparent"
                                   ToolTip="Increase Font Size" />

                        <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                        <!-- Bold Button -->
                        <ui:Button Command="{Binding Toolbar.ToggleTextBoldCommand}"
                                   Content="B"
                                   FontWeight="Bold"
                                   Width="28"
                                   Height="28"
                                   Margin="2,0"
                                   Padding="0"
                                   ToolTip="Bold">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Toolbar.IsTextBold}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <!-- Italic Button -->
                        <ui:Button Command="{Binding Toolbar.ToggleTextItalicCommand}"
                                   Content="I"
                                   FontStyle="Italic"
                                   FontWeight="SemiBold"
                                   Width="28"
                                   Height="28"
                                   Margin="2,0"
                                   Padding="0"
                                   ToolTip="Italic">
                            <ui:Button.Style>
                                <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Toolbar.IsTextItalic}" Value="True">
                                            <Setter Property="Appearance" Value="Primary" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ui:Button.Style>
                        </ui:Button>

                        <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                        <!-- Curated & Custom Color Swatches for Text -->
                        <ItemsControl ItemsSource="{Binding Toolbar.TextColorSwatches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                    <Button Width="26"
                                            Height="26"
                                            Margin="2"
                                            Padding="0"
                                            Cursor="Hand"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Command="{Binding DataContext.Toolbar.SelectTextColorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                            CommandParameter="{Binding Hex}"
                                            MouseRightButtonUp="ColorSwatchButton_MouseRightButtonUp">
                                        <Button.ToolTip>
                                            <ToolTip Content="{Binding Hex}" />
                                        </Button.ToolTip>
                                        <Grid>
                                            <Border x:Name="SelectionRing"
                                                    Width="24"
                                                    Height="24"
                                                    CornerRadius="12"
                                                    BorderThickness="2"
                                                    BorderBrush="Transparent" />
                                            <Ellipse Width="18"
                                                     Height="18"
                                                     Fill="{Binding FrozenBrush}"
                                                     Stroke="#33000000"
                                                     StrokeThickness="1" />
                                        </Grid>
                                    </Button>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Add Custom Color Button for Text -->
                        <ui:Button x:Name="AddCustomTextColorButton"
                                   Command="{Binding Toolbar.ToggleCustomColorPickerCommand}"
                                   Width="26"
                                   Height="26"
                                   Margin="2"
                                   Padding="0"
                                   ToolTip="Custom Color (RGB / Hex / Palette)"
                                   Style="{StaticResource ToolbarIconButtonStyle}">
                            <ui:SymbolIcon Symbol="Add24" FontSize="14" />
                        </ui:Button>

                        <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                        <!-- Delete Selected Text Object -->
                        <ui:Button Command="{Binding DeleteSelectedCommand}"
                                   Width="28"
                                   Height="28"
                                   Margin="2,0"
                                   Padding="0"
                                   ToolTip="Delete (Del)">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#E02020" />
                        </ui:Button>
                    </StackPanel>

                    <!-- Collapsible Custom Color Picker Panel for Text -->
                    <Border x:Name="TextCustomColorPickerPanel"
                            Margin="0,8,0,2"
                            Padding="8"
                            Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6"
                            Visibility="{Binding Toolbar.IsCustomColorPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Width="256">
                        <StackPanel Orientation="Vertical">
                            <!-- 1. Interactive 2D Color Spectrum Box (Saturation & Value) -->
                            <Border x:Name="TextColorSpectrumBox"
                                    Height="90"
                                    CornerRadius="4"
                                    ClipToBounds="True"
                                    Cursor="Cross"
                                    Background="{Binding Toolbar.CustomHueBaseBrush}"
                                    MouseLeftButtonDown="ColorSpectrumBox_MouseLeftButtonDown"
                                    MouseMove="ColorSpectrumBox_MouseMove"
                                    MouseLeftButtonUp="ColorSpectrumBox_MouseLeftButtonUp">
                                <Grid>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="#FFFFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#00000000" Offset="0" />
                                                <GradientStop Color="#FF000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>

                            <!-- Hue Slider (0-360) with Rainbow Gradient -->
                            <Grid Margin="0,6,0,6">
                                <Border Height="8" CornerRadius="4" ClipToBounds="True">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#FFFF0000" Offset="0.0" />
                                            <GradientStop Color="#FFFFFF00" Offset="0.17" />
                                            <GradientStop Color="#FF00FF00" Offset="0.33" />
                                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                                            <GradientStop Color="#FF0000FF" Offset="0.67" />
                                            <GradientStop Color="#FFFF00FF" Offset="0.83" />
                                            <GradientStop Color="#FFFF0000" Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Slider Minimum="0"
                                        Maximum="360"
                                        Value="{Binding Toolbar.CustomColorHue, Mode=TwoWay}"
                                        Opacity="0.85"
                                        VerticalAlignment="Center" />
                            </Grid>

                            <!-- 2. 24 Quick Spectrum Palette Grid -->
                            <ItemsControl ItemsSource="{x:Static vm:ToolbarViewModel.PaletteGridSwatches}"
                                          Margin="0,0,0,6">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                        <Button Width="24"
                                                Height="18"
                                                Margin="1"
                                                Padding="0"
                                                Cursor="Hand"
                                                Background="{Binding FrozenBrush}"
                                                BorderThickness="0"
                                                Command="{Binding DataContext.Toolbar.PickPaletteColorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                                CommandParameter="{Binding Hex}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="2" BorderThickness="0.5" BorderBrush="#33000000" />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 3. RGB Sliders and Numeric Inputs -->
                            <Grid Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- R -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#FFEF4444" />
                                <Slider Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Toolbar.CustomColorR, Mode=TwoWay}" Margin="6,1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding Toolbar.CustomColorR, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2,1" Height="20" HorizontalContentAlignment="Center" VerticalAlignment="Center" />

                                <!-- G -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#FF22C55E" />
                                <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Toolbar.CustomColorG, Mode=TwoWay}" Margin="6,1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Toolbar.CustomColorG, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2,1" Height="20" HorizontalContentAlignment="Center" VerticalAlignment="Center" />

                                <!-- B -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" FontWeight="Bold" FontSize="11" VerticalAlignment="Center" Foreground="#FF3B82F6" />
                                <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Toolbar.CustomColorB, Mode=TwoWay}" Margin="6,1" VerticalAlignment="Center" />
                                <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding Toolbar.CustomColorB, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" FontSize="11" Padding="2,1" Height="20" HorizontalContentAlignment="Center" VerticalAlignment="Center" />
                            </Grid>

                            <!-- 4. Hex Input, Live Preview, and Add & Use Button -->
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Live Preview -->
                                <Ellipse Grid.Column="0" Width="24" Height="24" Fill="{Binding Toolbar.CustomColorPreviewBrush}" Stroke="#44000000" StrokeThickness="1" />

                                <!-- Hex Input -->
                                <TextBox Grid.Column="2"
                                         Text="{Binding Toolbar.CustomColorHexInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontSize="11"
                                         FontFamily="Consolas"
                                         FontWeight="SemiBold"
                                         VerticalContentAlignment="Center"
                                         HorizontalContentAlignment="Center"
                                         Height="26"
                                         MaxLength="9"
                                         ToolTip="Hex Color Code (#RRGGBB)" />

                                <!-- Add & Use Button -->
                                <ui:Button Grid.Column="4"
                                           Command="{Binding Toolbar.AddCustomColorCommand}"
                                           Content="Add &amp; Use"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Appearance="Primary"
                                           Height="26"
                                           Padding="4,0"
                                           HorizontalAlignment="Stretch"
                                           ToolTip="Add to custom swatches and apply" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Compact Page Setup Popover -->
            <Border x:Name="PageSetupPopover"
                    Padding="10,8"
                    Visibility="{Binding IsPageSetupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,340,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- Presets -->
                    <ui:Button Content="A4"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.A4}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsA4Selected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="Letter"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.Letter}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLetterSelected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="Legal"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.Legal}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLegalSelected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="16:9"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.Slide16x9}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSlide16x9Selected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Dimensions Input: Width x Height -->
                    <TextBox x:Name="CustomWidthTextBox"
                             Width="64"
                             Height="28"
                             Padding="4,2"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="12"
                             Text="{Binding CustomWidthInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="4,0"
                               VerticalAlignment="Center"
                               Text="×"
                               FontSize="12" />

                    <TextBox x:Name="CustomHeightTextBox"
                             Width="64"
                             Height="28"
                             Padding="4,2"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="12"
                             Text="{Binding CustomHeightInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Unit Toggle (px / mm) -->
                    <ui:Button x:Name="UnitToggleButton"
                               Height="28"
                               Margin="6,0,0,0"
                               Padding="6,2"
                               FontSize="12"
                               Appearance="Transparent"
                               Content="{Binding DimensionUnitLabel}"
                               Command="{Binding ToggleDimensionUnitCommand}"
                               ToolTip="Toggle px / mm" />

                    <!-- Apply Checkmark Button -->
                    <ui:Button x:Name="ApplyDimensionsButton"
                               Width="30"
                               Height="28"
                               Margin="4,0,0,0"
                               Padding="0"
                               Appearance="Primary"
                               Command="{Binding ApplyPageDimensionsCommand}"
                               ToolTip="Apply Dimensions">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Compact PDF Export Popover -->
            <Border x:Name="PdfExportPopover"
                    Padding="10,8"
                    Visibility="{Binding IsPdfExportOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,70,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- Export Mode Pills: All | Current | Range -->
                    <ui:Button Content="All"
                               Command="{Binding SelectPdfExportModeCommand}"
                               CommandParameter="{x:Static models:PdfExportPageMode.AllPages}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportAll}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Current"
                               Command="{Binding SelectPdfExportModeCommand}"
                               CommandParameter="{x:Static models:PdfExportPageMode.CurrentPage}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportCurrent}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Range"
                               Command="{Binding SelectPdfExportModeCommand}"
                               CommandParameter="{x:Static models:PdfExportPageMode.CustomRange}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportRange}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Custom Range Input (revealed only in Range mode) -->
                    <TextBox x:Name="PdfCustomRangeTextBox"
                             Width="110"
                             Height="28"
                             Margin="4,0"
                             Padding="6,2"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Text="{Binding PdfCustomRangeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPdfExportRange, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="e.g. 1, 3, 5-8">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPdfRangeError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Primary Export Button -->
                    <ui:Button x:Name="ExecuteExportButton"
                               Height="28"
                               Padding="12,2"
                               Appearance="Primary"
                               Content="Export"
                               Command="{Binding ExecutePdfExportCommand}"
                               ToolTip="Export vector PDF to file" />
                </StackPanel>
            </Border>

            <!-- Right-Side Custom Pen Dock (Visible only when custom pens are defined) -->
            <Border x:Name="CustomPenRightDock"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0,0,16,0"
                    Padding="4,6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Background="{StaticResource ToolbarSolidBackgroundBrush}"
                    BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingSurfaceShadow}"
                    Visibility="{Binding Toolbar.HasCustomPenPresets, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                    <ItemsControl x:Name="CustomPenRightDockItemsControl"
                                  ItemsSource="{Binding Toolbar.CustomPenPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CustomPenPresetViewModel}">
                                <Button Width="36"
                                        Height="36"
                                        Margin="0,2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.ActivateCustomPenCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding}"
                                        MouseRightButtonUp="CustomPenPresetButton_MouseRightButtonUp"
                                        ToolTip="{Binding TooltipText}">
                                    <Grid>
                                        <!-- Selection Ring -->
                                        <Border x:Name="SelectionRing"
                                                Width="34"
                                                Height="34"
                                                CornerRadius="8"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />

                                        <!-- Pen Color & Thickness Preview Dot -->
                                        <Ellipse Width="{Binding DotDiameter}"
                                                 Height="{Binding DotDiameter}"
                                                 Fill="{Binding FrozenBrush}"
                                                 Stroke="#33000000"
                                                 StrokeThickness="1"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center" />

                                        <!-- Shortcut Badge Overlay -->
                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                CornerRadius="3"
                                                Padding="2,0"
                                                Height="12"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Bottom"
                                                Margin="0,0,1,1"
                                                Visibility="{Binding HasShortcut, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="{Binding Shortcut}"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="SelectionRing" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" Margin="2,4" />

                    <!-- Add New Custom Pen Preset Button -->
                    <ui:Button x:Name="AddCustomPenDockButton"
                               Command="{Binding Toolbar.OpenNewCustomPenEditorCommand}"
                               Width="32"
                               Height="32"
                               Padding="0"
                               Margin="0,1"
                               ToolTip="Add Custom Pen Preset"
                               Style="{StaticResource ToolbarIconButtonStyle}">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Custom Pen Preset Editor Popover / Dialog -->
            <Border x:Name="CustomPenEditorPopover"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,72,0"
                    Width="280"
                    Padding="14,12"
                    Background="{StaticResource ToolbarSolidBackgroundBrush}"
                    BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingSurfaceShadow}"
                    Visibility="{Binding Toolbar.IsCustomPenEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Vertical">
                    <!-- Header -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Custom Pen Preset"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   VerticalAlignment="Center" />

                        <!-- Live Preview Dot -->
                        <Ellipse Grid.Column="1"
                                 Width="{Binding Toolbar.CustomPenEditorPreviewDiameter}"
                                 Height="{Binding Toolbar.CustomPenEditorPreviewDiameter}"
                                 Fill="{Binding Toolbar.CustomPenEditorPreviewBrush}"
                                 Stroke="#33000000"
                                 StrokeThickness="1"
                                 Margin="8,0"
                                 VerticalAlignment="Center" />

                        <ui:Button Grid.Column="2"
                                   Command="{Binding Toolbar.CloseCustomPenEditorCommand}"
                                   Style="{StaticResource ToolbarIconButtonStyle}"
                                   Width="24"
                                   Height="24"
                                   Padding="0"
                                   ToolTip="Close (Esc)">
                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                        </ui:Button>
                    </Grid>

                    <!-- Name Input -->
                    <TextBlock Text="Name" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,4" />
                    <TextBox x:Name="CustomPenNameTextBox"
                             Text="{Binding Toolbar.CustomPenEditorName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Height="28"
                             FontSize="12"
                             Padding="6,3"
                             MaxLength="64"
                             VerticalContentAlignment="Center"
                             Margin="0,0,0,8" />

                    <!-- Color Swatches Grid -->
                    <TextBlock Text="Color" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,4" />
                    <ItemsControl ItemsSource="{Binding Toolbar.ColorSwatches}" Margin="0,0,0,6">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                <Button Width="24"
                                        Height="24"
                                        Margin="2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.SelectCustomPenEditorColorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding Hex}"
                                        ToolTip="{Binding Hex}">
                                    <Grid>
                                        <Border x:Name="SelectionRing"
                                                Width="22"
                                                Height="22"
                                                CornerRadius="11"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />
                                        <Ellipse Width="16"
                                                 Height="16"
                                                 Fill="{Binding FrozenBrush}"
                                                 Stroke="#33000000"
                                                 StrokeThickness="1" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Thickness Slider -->
                    <Grid Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Thickness" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Grid.Column="1" Text="{Binding Toolbar.CustomPenEditorThickness, StringFormat='{}{0:0.0} px'}" FontSize="11" FontWeight="Bold" />
                    </Grid>
                    <Slider Minimum="0.5"
                            Maximum="24.0"
                            Value="{Binding Toolbar.CustomPenEditorThickness, Mode=TwoWay}"
                            Margin="0,0,0,8" />

                    <!-- Shortcut Key Input -->
                    <TextBlock Text="Shortcut (e.g. 1, 2, Shift+R, Alt+1)" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,4" />
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="CustomPenShortcutTextBox"
                                 Grid.Column="0"
                                 Text="{Binding Toolbar.CustomPenEditorShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="CustomPenShortcutTextBox_PreviewKeyDown"
                                 Height="28"
                                 FontSize="12"
                                 FontFamily="Consolas"
                                 FontWeight="SemiBold"
                                 Padding="6,3"
                                 MaxLength="32"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Press key combination or type shortcut" />
                        <ui:Button Grid.Column="1"
                                   Command="{Binding Toolbar.ClearCustomPenEditorShortcutCommand}"
                                   Content="Clear"
                                   Height="28"
                                   Margin="6,0,0,0"
                                   Padding="8,0"
                                   FontSize="11" />
                    </Grid>

                    <!-- Shortcut Error Message (if any) -->
                    <TextBlock Text="{Binding Toolbar.CustomPenEditorShortcutError}"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               Visibility="{Binding Toolbar.HasCustomPenEditorShortcutError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Delete Button (Only when editing existing) -->
                        <ui:Button x:Name="DeleteCustomPenButton"
                                   Grid.Column="0"
                                   Command="{Binding Toolbar.DeleteCustomPenPresetCommand}"
                                   Content="Delete"
                                   FontSize="11"
                                   Height="28"
                                   Padding="10,0"
                                   Foreground="#E02020"
                                   Visibility="{Binding Toolbar.IsEditingExistingCustomPen, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <!-- Save & Use Button -->
                        <ui:Button x:Name="SaveCustomPenButton"
                                   Grid.Column="1"
                                   Command="{Binding Toolbar.SaveCustomPenPresetCommand}"
                                   Content="Save &amp; Use"
                                   Appearance="Primary"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Height="28"
                                   HorizontalAlignment="Right"
                                   Padding="14,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Bottom-Left PDF Export Progress / Status Pill -->
            <Border x:Name="ExportStatusPill"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="16"
                    Padding="12,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource ToolbarSolidBackgroundBrush}"
                    BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingSurfaceShadow}"
                    Visibility="{Binding IsExportStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- In-Progress State -->
                    <StackPanel x:Name="ExportInProgressPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,8,0" />
                        <TextBlock Text="Exporting PDF" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <ProgressBar x:Name="ExportProgressBar"
                                     Width="120"
                                     Height="6"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding ExportProgressPercentage}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                        <TextBlock x:Name="ExportProgressText"
                                   Text="{Binding ExportProgressPercentage, StringFormat={}{0:0}%}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   MinWidth="30"
                                   TextAlignment="Right" />
                    </StackPanel>

                    <!-- Completed State -->
                    <StackPanel x:Name="ExportCompletedPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExportCompleted}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" Foreground="#107C41" Margin="0,0,8,0" />
                        <TextBlock x:Name="ExportFinishedText"
                                   Text="{Binding ExportStatusMessage, FallbackValue='Export finished'}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Close / Dismiss Button -->
                    <ui:Button x:Name="DismissExportStatusButton"
                               Command="{Binding DismissExportStatusCommand}"
                               Width="20"
                               Height="20"
                               Padding="0"
                               CornerRadius="4"
                               Margin="8,0,0,0"
                               Appearance="Transparent"
                               ToolTip="Dismiss">
                        <ui:SymbolIcon Symbol="Dismiss16" FontSize="10" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Bottom-Right Minimalist Corner HUD Pill -->
            <Border x:Name="CornerHudPill"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="16"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource ToolbarSolidBackgroundBrush}"
                    BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingSurfaceShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="PreviousPageButton"
                               Command="{Binding PreviousPageCommand}"
                               Width="24"
                               Height="24"
                               Padding="0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               ToolTip="Previous Page (PageUp)">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                    </ui:Button>

                    <TextBlock x:Name="PageIndicatorText"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding PageIndicatorDisplay, FallbackValue='1 / 1'}" />

                    <ui:Button x:Name="NextPageButton"
                               Command="{Binding NextPageCommand}"
                               Width="24"
                               Height="24"
                               Padding="0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               ToolTip="Next Page (PageDown)">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" />
                    </ui:Button>

                    <Border Width="1"
                            Height="14"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ui:Button x:Name="ResetZoomButton"
                               Command="{Binding ResetZoomCommand}"
                               Height="24"
                               Padding="6,0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               Content="{Binding ZoomPercentageDisplay, FallbackValue='100%'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               ToolTip="Reset Zoom (Ctrl+0)" />
                </StackPanel>
            </Border>

            <!-- Help & Keyboard Shortcuts Modal Dialog Overlay -->
            <Grid x:Name="HelpDialogOverlay"
                  Grid.Row="0"
                  Grid.RowSpan="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Panel.ZIndex="100"
                  Background="#7F000000"
                  Visibility="{Binding IsHelpOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                  MouseLeftButtonDown="HelpDialogBackdrop_MouseLeftButtonDown">

                <!-- Dialog Card -->
                <Border x:Name="HelpDialogCard"
                        Width="620"
                        MaxHeight="560"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{StaticResource ToolbarSolidBackgroundBrush}"
                        BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="24,20"
                        Effect="{StaticResource FloatingSurfaceShadow}"
                        MouseLeftButtonDown="HelpDialogCard_MouseLeftButtonDown">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="QuestionCircle24"
                                               FontSize="20"
                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                               Margin="0,0,10,0"
                                               VerticalAlignment="Center" />
                                <TextBlock Text="Help &amp; Keyboard Shortcuts"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ui:Button x:Name="CloseHelpDialogButton"
                                       Grid.Column="1"
                                       Command="{Binding CloseHelpCommand}"
                                       Style="{StaticResource ToolbarIconButtonStyle}"
                                       ToolTip="Close (Esc)">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" />
                            </ui:Button>
                        </Grid>

                        <Border Grid.Row="1"
                                Height="1"
                                Margin="0,0,0,16"
                                Background="{StaticResource ToolbarSolidBorderBrush}" />

                        <!-- Shortcuts Two-Column Grid -->
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Column 1: Tools & Inking -->
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="TOOLS &amp; DRAWING"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="V" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Pointer (Select &amp; Pan)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="P" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Pen Tool" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="H" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Highlighter Tool" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Eraser (Cycle modes)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="L" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Lasso (Cycle filters)" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="T" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Insert Text Box" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2" MinWidth="26">
                                            <TextBlock Text="I" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Insert Image" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="Space (Hold)" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Temporary Pan Mode" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="1–9 / Custom" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Activate Custom Pen" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>
                                </StackPanel>

                                <!-- Column 2: Document, Navigation & Editing -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="DOCUMENT &amp; SHORTCUTS"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Margin="0,0,0,8" />

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="2x Click / F2" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Rename Document Title" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="Ctrl + N / O / S" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="New / Open / Save" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="Ctrl + E" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Export Vector PDF" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="Ctrl + C / V" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Copy / Paste Object" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="Ctrl + Z / Y" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Undo / Redo" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="5,2">
                                            <TextBlock Text="Del / Backspace" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="Delete Selected Item" Margin="10,0,0,0" VerticalAlignment="Center" FontSize="12" />
                                    </Grid>

                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
