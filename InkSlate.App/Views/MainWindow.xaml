<ui:FluentWindow x:Class="InkSlate.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:models="clr-namespace:InkSlate.Core.Models;assembly=InkSlate.Core"
                 xmlns:controls="clr-namespace:InkSlate.App.Controls"
                 xmlns:vm="clr-namespace:InkSlate.App.ViewModels"
                 Title="InkSlate"
                 Width="1280"
                 Height="800"
                 MinWidth="720"
                 MinHeight="480"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DropShadowEffect x:Key="FloatingSurfaceShadow"
                          BlurRadius="14"
                          ShadowDepth="3"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.22"
                          po:Freeze="True" />

        <DropShadowEffect x:Key="PageSheetShadow"
                          BlurRadius="8"
                          ShadowDepth="2"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.16"
                          po:Freeze="True" />

        <SolidColorBrush x:Key="PageBorderBrush"
                         Color="#1A000000"
                         po:Freeze="True" />

        <DataTemplate x:Key="PageSheetDataTemplate">
            <Border Width="{Binding Width}"
                    Height="{Binding Height}"
                    Margin="0,0,0,24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    ClipToBounds="True"
                    Background="{Binding BackgroundHex, FallbackValue=#FFFFFFFF}"
                    BorderBrush="{StaticResource PageBorderBrush}"
                    BorderThickness="1"
                    Effect="{StaticResource PageSheetShadow}">
                <controls:PageCanvasControl PageId="{Binding Id}"
                                            PageStrokes="{Binding Strokes, Mode=TwoWay}"
                                            UndoRedoManager="{Binding UndoRedo}"
                                            IsPageDirty="{Binding IsDirty, Mode=TwoWay}"
                                            InkDrawingAttributes="{Binding Toolbar.CurrentDrawingAttributes}"
                                            ActiveToolMode="{Binding Toolbar.ActiveTool, FallbackValue={x:Static models:ToolMode.Pointer}}"
                                            ActiveEraserMode="{Binding Toolbar.SelectedEraserMode, FallbackValue={x:Static models:EraserMode.Stroke}}"
                                            EraserSize="{Binding Toolbar.SelectedEraserSize, FallbackValue=16.0}"
                                            ActiveLassoFilterMode="{Binding Toolbar.SelectedLassoFilterMode, FallbackValue={x:Static models:LassoFilterMode.AllObjects}}"
                                            PageElements="{Binding Elements}"
                                            RemoveElementCommand="{Binding RemoveElementCommand}" />
            </Border>
        </DataTemplate>

        <Style x:Key="ToolbarIconButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ToolbarToolButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="Width" Value="20" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="0,6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PresetPillButtonStyle" TargetType="ui:Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <SolidColorBrush x:Key="ToolbarSolidBackgroundBrush" Color="#FF242424" po:Freeze="True" />
        <SolidColorBrush x:Key="ToolbarSolidBorderBrush" Color="#FF3D3D3D" po:Freeze="True" />

        <Style x:Key="SubtoolStackPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="Orientation" Value="Vertical" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SubtoolSeparatorStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ToolbarSolidBorderBrush}" />
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="Width" Value="24" />
                    <Setter Property="Height" Value="1" />
                    <Setter Property="Margin" Value="2,6" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PopoverContainerStyle" TargetType="Border">
            <Setter Property="Grid.Row" Value="0" />
            <Setter Property="Grid.RowSpan" Value="2" />
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,48,0,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                    <Setter Property="HorizontalAlignment" Value="Left" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="48,70,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                    <Setter Property="HorizontalAlignment" Value="Center" />
                    <Setter Property="VerticalAlignment" Value="Top" />
                    <Setter Property="Margin" Value="0,52,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Drag & Caption TitleBar -->
        <ui:TitleBar Grid.Row="0"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     ShowHelp="False" />

        <!-- Main Workspace Layer -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Viewport Region (Dual View Modes: Consecutive & Separated) -->
            <Border x:Name="ViewportRegion"
                    Background="Transparent"
                    ClipToBounds="True">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: TopDocked (Row 1, Column 0 Span 2) -->
                        <Setter Property="Grid.Row" Value="1" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <controls:ZoomScrollViewer x:Name="ViewportScrollViewer"
                                           ZoomLevel="{Binding ZoomLevel, Mode=TwoWay}"
                                           CurrentViewMode="{Binding CurrentViewMode}"
                                           ActiveToolMode="{Binding Toolbar.ActiveTool}"
                                           PreviousPageCommand="{Binding PreviousPageCommand}"
                                           NextPageCommand="{Binding NextPageCommand}"
                                           Background="Transparent">
                    <Grid HorizontalAlignment="Center"
                          VerticalAlignment="Top">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Margin" Value="0,24,0,32" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                        <Setter Property="Margin" Value="0,60,0,32" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <!-- Consecutive View: Virtualized Continuous Vertical Stack -->
                        <ItemsControl x:Name="ConsecutivePagesControl"
                                      ItemsSource="{Binding Pages}"
                                      ItemTemplate="{StaticResource PageSheetDataTemplate}"
                                      VirtualizingPanel.IsVirtualizing="True"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      VirtualizingPanel.ScrollUnit="Pixel"
                                      VirtualizingPanel.CacheLength="1,1"
                                      VirtualizingPanel.CacheLengthUnit="Page"
                                      Visibility="{Binding IsConsecutiveView, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel IsVirtualizing="True"
                                                            VirtualizationMode="Recycling"
                                                            ScrollUnit="Pixel"
                                                            CacheLength="1,1"
                                                            CacheLengthUnit="Page"
                                                            HorizontalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <!-- Separated View: Single-Page Presentation Focus Mode -->
                        <ContentControl x:Name="SeparatedPageHost"
                                        Content="{Binding ActivePage}"
                                        ContentTemplate="{StaticResource PageSheetDataTemplate}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Visibility="{Binding IsSeparatedView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </controls:ZoomScrollViewer>
            </Border>

            <!-- Command Bar (Top Docked, Left Docked Sidebar, or Top Floating) -->
            <Border x:Name="FloatingCommandBar">
                <Border.Style>
                    <Style TargetType="Border">
                        <!-- Default: TopDocked -->
                        <Setter Property="Grid.Row" Value="0" />
                        <Setter Property="Grid.RowSpan" Value="1" />
                        <Setter Property="Grid.Column" Value="0" />
                        <Setter Property="Grid.ColumnSpan" Value="2" />
                        <Setter Property="HorizontalAlignment" Value="Stretch" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                        <Setter Property="BorderThickness" Value="0,0,0,1" />
                        <Setter Property="CornerRadius" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="Effect" Value="{x:Null}" />
                        <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Stretch" />
                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                <Setter Property="CornerRadius" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="4,8" />
                                <Setter Property="Effect" Value="{x:Null}" />
                                <Setter Property="Background" Value="{DynamicResource LayerFillColorDefaultBrush}" />
                                <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.TopFloating}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="2" />
                                <Setter Property="HorizontalAlignment" Value="Center" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="CornerRadius" Value="8" />
                                <Setter Property="Margin" Value="0,8,0,0" />
                                <Setter Property="Padding" Value="6,4" />
                                <Setter Property="Effect" Value="{StaticResource FloatingSurfaceShadow}" />
                                <Setter Property="Background" Value="{StaticResource ToolbarSolidBackgroundBrush}" />
                                <Setter Property="BorderBrush" Value="{StaticResource ToolbarSolidBorderBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Orientation" Value="Horizontal" />
                            <Setter Property="HorizontalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                    <Setter Property="Orientation" Value="Vertical" />
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="VerticalAlignment" Value="Top" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- File & Export -->
                    <ui:Button x:Name="OpenButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Command="{Binding OpenCommand}"
                               ToolTip="Open (Ctrl+O)">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="SaveButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Command="{Binding SaveCommand}"
                               ToolTip="Save (Ctrl+S)">
                        <ui:SymbolIcon Symbol="Save24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ExportPdfButton"
                               Command="{Binding TogglePdfExportCommand}"
                               ToolTip="Export PDF (Ctrl+E)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportOpen}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Canvas Tools -->
                    <ui:Button x:Name="PointerToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Pointer}"
                               ToolTip="Pointer / Select &amp; Pan (V)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsPointerToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Cursor24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="PenToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Pen}"
                               ToolTip="Pen (P)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsPenToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Pen24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="HighlighterToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Highlighter}"
                               ToolTip="Highlighter (H)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsHighlighterToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Highlight24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="EraserToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Eraser}"
                               ToolTip="Eraser (E)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsEraserToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Eraser24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="LassoToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Lasso}"
                               ToolTip="Lasso (L)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Lasso24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="TextToolButton"
                               Command="{Binding Toolbar.SelectToolCommand}"
                               CommandParameter="{x:Static models:ToolMode.Text}"
                               ToolTip="Text (T)">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarToolButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsTextToolActive}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentControlElevationBorderBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="TextFont24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ImageToolButton"
                               Command="{Binding InsertImageCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Image (I)">
                        <ui:SymbolIcon Symbol="Image24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Undo / Redo -->
                    <ui:Button x:Name="UndoButton"
                               Command="{Binding UndoCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Undo (Ctrl+Z)">
                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="RedoButton"
                               Command="{Binding RedoCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Redo (Ctrl+Y)">
                        <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Page & View Management -->
                    <ui:Button x:Name="AddPageButton"
                               Command="{Binding AddPageCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Add Page (Ctrl+Enter)">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="PageSetupButton"
                               Command="{Binding TogglePageSetupCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Page Setup">
                        <ui:SymbolIcon Symbol="PageFit24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ToggleViewModeButton"
                               Command="{Binding ToggleViewModeCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Toggle View: Consecutive / Separated (F5)">
                        <ui:SymbolIcon Symbol="SlideMultiple24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Toolbar Placement Cycle Button -->
                    <ui:Button x:Name="CyclePlacementButton"
                               Command="{Binding Toolbar.CyclePlacementCommand}"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Cycle Toolbar Position: Fixed Top / Left Sidebar / Floating">
                        <ui:SymbolIcon Symbol="PanelLeft24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Compact Pen Options Popover -->
            <Border x:Name="PenOptionsPopover"
                    Padding="10,6"
                    Visibility="{Binding Toolbar.IsPenOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,140,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- 6 Curated Color Swatches (Zero text labels) -->
                    <ItemsControl x:Name="ColorSwatchesItemsControl"
                                  ItemsSource="{Binding Toolbar.ColorSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                <Button Width="26"
                                        Height="26"
                                        Margin="2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.SelectColorSwatchCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding Hex}">
                                    <Grid>
                                        <Border x:Name="SelectionRing"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="{Binding FrozenBrush}"
                                                 Stroke="#33000000"
                                                 StrokeThickness="1" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- 4 Thickness Dots (Zero text labels) -->
                    <ItemsControl x:Name="ThicknessDotsItemsControl"
                                  ItemsSource="{Binding Toolbar.ThicknessOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ThicknessOption}">
                                <Button Width="26"
                                        Height="26"
                                        Margin="2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.SelectPenThicknessCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding ThicknessDip}">
                                    <Grid>
                                        <Border x:Name="SelectionRing"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />
                                        <Ellipse x:Name="Dot"
                                                 Width="{Binding DotDiameter}"
                                                 Height="{Binding DotDiameter}"
                                                 Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Compact Eraser Options Popover -->
            <Border x:Name="EraserOptionsPopover"
                    Padding="10,6"
                    Visibility="{Binding Toolbar.IsEraserOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,210,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- 3-Mode Segmented Eraser Buttons -->
                    <ui:Button x:Name="StrokeEraserModeButton"
                               Command="{Binding Toolbar.SelectEraserModeCommand}"
                               CommandParameter="{x:Static models:EraserMode.Stroke}"
                               ToolTip="Stroke Eraser">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsStrokeEraserMode}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Eraser24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="PointEraserModeButton"
                               Command="{Binding Toolbar.SelectEraserModeCommand}"
                               CommandParameter="{x:Static models:EraserMode.Point}"
                               ToolTip="Point Eraser">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsPointEraserMode}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="CircleSmall24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="ObjectEraserModeButton"
                               Command="{Binding Toolbar.SelectEraserModeCommand}"
                               CommandParameter="{x:Static models:EraserMode.Object}"
                               ToolTip="Object Eraser">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsObjectEraserMode}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Shapes24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- 3 Eraser Size Dots (Zero text labels) -->
                    <ItemsControl x:Name="EraserSizeDotsItemsControl"
                                  ItemsSource="{Binding Toolbar.EraserSizeOptions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EraserSizeOption}">
                                <Button Width="26"
                                        Height="26"
                                        Margin="2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.SelectEraserSizeCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding SizeDip}">
                                    <Grid>
                                        <Border x:Name="SelectionRing"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />
                                        <Ellipse x:Name="Dot"
                                                 Width="{Binding DotDiameter}"
                                                 Height="{Binding DotDiameter}"
                                                 Fill="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Compact Lasso Options Popover -->
            <Border x:Name="LassoOptionsPopover"
                    Padding="6,4"
                    Visibility="{Binding Toolbar.IsLassoOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,245,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <ui:Button x:Name="LassoStrokesOnlyButton"
                               Command="{Binding Toolbar.SelectLassoFilterCommand}"
                               CommandParameter="{x:Static models:LassoFilterMode.StrokesOnly}"
                               ToolTip="Strokes Only">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoStrokesOnly}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Pen24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="LassoElementsOnlyButton"
                               Command="{Binding Toolbar.SelectLassoFilterCommand}"
                               CommandParameter="{x:Static models:LassoFilterMode.ElementsOnly}"
                               ToolTip="Elements Only">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoElementsOnly}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="Shapes24" FontSize="18" />
                    </ui:Button>

                    <ui:Button x:Name="LassoAllObjectsButton"
                               Command="{Binding Toolbar.SelectLassoFilterCommand}"
                               CommandParameter="{x:Static models:LassoFilterMode.AllObjects}"
                               ToolTip="All Objects">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsLassoAllObjects}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                        <ui:SymbolIcon Symbol="SlideMultiple24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Compact Text Options Popover -->
            <Border x:Name="TextOptionsPopover"
                    Padding="8,6"
                    Visibility="{Binding Toolbar.IsTextOptionsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,280,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- Decrease Font Size -->
                    <ui:Button Command="{Binding Toolbar.DecreaseTextFontSizeCommand}"
                               Content="A-"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Width="28"
                               Height="28"
                               Margin="2,0"
                               Padding="0"
                               Appearance="Transparent"
                               ToolTip="Decrease Font Size" />

                    <!-- Font Size Display -->
                    <TextBlock Text="{Binding Toolbar.SelectedTextFontSize, StringFormat={}{0:0}}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               FontSize="12"
                               Width="22"
                               TextAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <!-- Increase Font Size -->
                    <ui:Button Command="{Binding Toolbar.IncreaseTextFontSizeCommand}"
                               Content="A+"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Width="28"
                               Height="28"
                               Margin="2,0"
                               Padding="0"
                               Appearance="Transparent"
                               ToolTip="Increase Font Size" />

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Bold Button -->
                    <ui:Button Command="{Binding Toolbar.ToggleTextBoldCommand}"
                               Content="B"
                               FontWeight="Bold"
                               Width="28"
                               Height="28"
                               Margin="2,0"
                               Padding="0"
                               ToolTip="Bold">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsTextBold}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Italic Button -->
                    <ui:Button Command="{Binding Toolbar.ToggleTextItalicCommand}"
                               Content="I"
                               FontStyle="Italic"
                               FontWeight="SemiBold"
                               Width="28"
                               Height="28"
                               Margin="2,0"
                               Padding="0"
                               ToolTip="Italic">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource ToolbarIconButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Toolbar.IsTextItalic}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Curated Color Swatches for Text -->
                    <ItemsControl ItemsSource="{Binding Toolbar.TextColorSwatches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ColorSwatchOption}">
                                <Button Width="26"
                                        Height="26"
                                        Margin="2"
                                        Padding="0"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Command="{Binding DataContext.Toolbar.SelectTextColorCommand, RelativeSource={RelativeSource AncestorType=ui:FluentWindow}}"
                                        CommandParameter="{Binding Hex}">
                                    <Grid>
                                        <Border x:Name="SelectionRing"
                                                Width="24"
                                                Height="24"
                                                CornerRadius="12"
                                                BorderThickness="2"
                                                BorderBrush="Transparent" />
                                        <Ellipse Width="18"
                                                 Height="18"
                                                 Fill="{Binding FrozenBrush}"
                                                 Stroke="#33000000"
                                                 StrokeThickness="1" />
                                    </Grid>
                                </Button>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter TargetName="SelectionRing" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Delete Selected Text Object -->
                    <ui:Button Command="{Binding DeleteSelectedCommand}"
                               Width="28"
                               Height="28"
                               Margin="2,0"
                               Padding="0"
                               ToolTip="Delete (Del)">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="14" Foreground="#E02020" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Compact Page Setup Popover -->
            <Border x:Name="PageSetupPopover"
                    Padding="10,8"
                    Visibility="{Binding IsPageSetupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,340,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- Presets -->
                    <ui:Button Content="A4"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.A4}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsA4Selected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="Letter"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.Letter}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLetterSelected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="Legal"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.Legal}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLegalSelected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>
                    <ui:Button Content="16:9"
                               Command="{Binding SelectPresetCommand}"
                               CommandParameter="{x:Static models:PageDimensionPreset.Slide16x9}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSlide16x9Selected}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Dimensions Input: Width x Height -->
                    <TextBox x:Name="CustomWidthTextBox"
                             Width="64"
                             Height="28"
                             Padding="4,2"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="12"
                             Text="{Binding CustomWidthInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <TextBlock Margin="4,0"
                               VerticalAlignment="Center"
                               Text="×"
                               FontSize="12" />

                    <TextBox x:Name="CustomHeightTextBox"
                             Width="64"
                             Height="28"
                             Padding="4,2"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Center"
                             FontSize="12"
                             Text="{Binding CustomHeightInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                    <!-- Unit Toggle (px / mm) -->
                    <ui:Button x:Name="UnitToggleButton"
                               Height="28"
                               Margin="6,0,0,0"
                               Padding="6,2"
                               FontSize="12"
                               Appearance="Transparent"
                               Content="{Binding DimensionUnitLabel}"
                               Command="{Binding ToggleDimensionUnitCommand}"
                               ToolTip="Toggle px / mm" />

                    <!-- Apply Checkmark Button -->
                    <ui:Button x:Name="ApplyDimensionsButton"
                               Width="30"
                               Height="28"
                               Margin="4,0,0,0"
                               Padding="0"
                               Appearance="Primary"
                               Command="{Binding ApplyPageDimensionsCommand}"
                               ToolTip="Apply Dimensions">
                        <ui:SymbolIcon Symbol="Checkmark24" FontSize="16" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Compact PDF Export Popover -->
            <Border x:Name="PdfExportPopover"
                    Padding="10,8"
                    Visibility="{Binding IsPdfExportOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource PopoverContainerStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Toolbar.Placement}" Value="{x:Static models:ToolbarPlacement.LeftDocked}">
                                <Setter Property="HorizontalAlignment" Value="Left" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Margin" Value="48,70,0,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Style="{StaticResource SubtoolStackPanelStyle}">
                    <!-- Export Mode Pills: All | Current | Range -->
                    <ui:Button Content="All"
                               Command="{Binding SelectPdfExportModeCommand}"
                               CommandParameter="{x:Static models:PdfExportPageMode.AllPages}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportAll}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Current"
                               Command="{Binding SelectPdfExportModeCommand}"
                               CommandParameter="{x:Static models:PdfExportPageMode.CurrentPage}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportCurrent}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="Range"
                               Command="{Binding SelectPdfExportModeCommand}"
                               CommandParameter="{x:Static models:PdfExportPageMode.CustomRange}">
                        <ui:Button.Style>
                            <Style TargetType="ui:Button" BasedOn="{StaticResource PresetPillButtonStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPdfExportRange}" Value="True">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <!-- Custom Range Input (revealed only in Range mode) -->
                    <TextBox x:Name="PdfCustomRangeTextBox"
                             Width="110"
                             Height="28"
                             Margin="4,0"
                             Padding="6,2"
                             VerticalContentAlignment="Center"
                             FontSize="12"
                             Text="{Binding PdfCustomRangeInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Visibility="{Binding IsPdfExportRange, Converter={StaticResource BooleanToVisibilityConverter}}"
                             ToolTip="e.g. 1, 3, 5-8">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPdfRangeError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        <Setter Property="BorderThickness" Value="1.5" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <Border Style="{StaticResource SubtoolSeparatorStyle}" />

                    <!-- Primary Export Button -->
                    <ui:Button x:Name="ExecuteExportButton"
                               Height="28"
                               Padding="12,2"
                               Appearance="Primary"
                               Content="Export"
                               Command="{Binding ExecutePdfExportCommand}"
                               ToolTip="Export vector PDF to file" />
                </StackPanel>
            </Border>

            <!-- Bottom-Right Minimalist Corner HUD Pill -->
            <Border x:Name="CornerHudPill"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="16"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{StaticResource ToolbarSolidBackgroundBrush}"
                    BorderBrush="{StaticResource ToolbarSolidBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingSurfaceShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="PreviousPageButton"
                               Command="{Binding PreviousPageCommand}"
                               Width="24"
                               Height="24"
                               Padding="0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               ToolTip="Previous Page (PageUp)">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                    </ui:Button>

                    <TextBlock x:Name="PageIndicatorText"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="{Binding PageIndicatorDisplay, FallbackValue='1 / 1'}" />

                    <ui:Button x:Name="NextPageButton"
                               Command="{Binding NextPageCommand}"
                               Width="24"
                               Height="24"
                               Padding="0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               ToolTip="Next Page (PageDown)">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" />
                    </ui:Button>

                    <Border Width="1"
                            Height="14"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ui:Button x:Name="ResetZoomButton"
                               Command="{Binding ResetZoomCommand}"
                               Height="24"
                               Padding="6,0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               Content="{Binding ZoomPercentageDisplay, FallbackValue='100%'}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               ToolTip="Reset Zoom (Ctrl+0)" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
