<ui:FluentWindow x:Class="InkSlate.App.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="InkSlate"
                 Width="1280"
                 Height="800"
                 MinWidth="720"
                 MinHeight="480"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen">
    <ui:FluentWindow.Resources>
        <DropShadowEffect x:Key="FloatingSurfaceShadow"
                          BlurRadius="14"
                          ShadowDepth="3"
                          Direction="270"
                          Color="#000000"
                          Opacity="0.22" />

        <Style x:Key="ToolbarIconButtonStyle" TargetType="ui:Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Appearance" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ToolbarSeparatorStyle" TargetType="Border">
            <Setter Property="Width" Value="1" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Drag & Caption TitleBar (no redundant title text or menus) -->
        <ui:TitleBar Grid.Row="0"
                     ShowMinimize="True"
                     ShowMaximize="True"
                     ShowClose="True"
                     ShowHelp="False" />

        <!-- Main Workspace Layer -->
        <Grid Grid.Row="1">
            <!-- Viewport Region (to be wired to ZoomScrollViewer & PageViewModels in Steps 2.2-2.4) -->
            <Border x:Name="ViewportRegion"
                    Background="Transparent"
                    ClipToBounds="True">
                <Border Width="793.7"
                        Height="1122.5"
                        Margin="0,60,0,32"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="#FFFFFFFF"
                        BorderBrush="#1A000000"
                        BorderThickness="1"
                        Effect="{StaticResource FloatingSurfaceShadow}" />
            </Border>

            <!-- Top Floating Command Bar (Icon-Only, Zero Redundant Text) -->
            <Border x:Name="FloatingCommandBar"
                    Height="44"
                    Margin="0,4,0,0"
                    Padding="6,4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Effect="{StaticResource FloatingSurfaceShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- File & Export -->
                    <ui:Button x:Name="OpenButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Open (Ctrl+O)">
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="SaveButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Save (Ctrl+S)">
                        <ui:SymbolIcon Symbol="Save24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ExportPdfButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Export PDF (Ctrl+E)">
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Canvas Tools -->
                    <ui:Button x:Name="PenToolButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               Appearance="Primary"
                               ToolTip="Pen (P)">
                        <ui:SymbolIcon Symbol="Pen24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="HighlighterToolButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Highlighter (H)">
                        <ui:SymbolIcon Symbol="Highlight24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="EraserToolButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Eraser (E)">
                        <ui:SymbolIcon Symbol="Eraser24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="LassoToolButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Lasso (L)">
                        <ui:SymbolIcon Symbol="Lasso24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="TextToolButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Text (T)">
                        <ui:SymbolIcon Symbol="TextFont24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ImageToolButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Image (I)">
                        <ui:SymbolIcon Symbol="Image24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Undo / Redo -->
                    <ui:Button x:Name="UndoButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Undo (Ctrl+Z)">
                        <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="RedoButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Redo (Ctrl+Y)">
                        <ui:SymbolIcon Symbol="ArrowRedo24" FontSize="18" />
                    </ui:Button>

                    <Border Style="{StaticResource ToolbarSeparatorStyle}" />

                    <!-- Page & View Management -->
                    <ui:Button x:Name="AddPageButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Add Page (Ctrl+Enter)">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="PageSetupButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Page Setup">
                        <ui:SymbolIcon Symbol="PageFit24" FontSize="18" />
                    </ui:Button>
                    <ui:Button x:Name="ToggleViewModeButton"
                               Style="{StaticResource ToolbarIconButtonStyle}"
                               ToolTip="Toggle View: Consecutive / Separated (F5)">
                        <ui:SymbolIcon Symbol="SlideMultiple24" FontSize="18" />
                    </ui:Button>
                </StackPanel>
            </Border>

            <!-- Bottom-Right Minimalist Corner HUD Pill -->
            <Border x:Name="CornerHudPill"
                    Margin="16"
                    Padding="10,4"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Effect="{StaticResource FloatingSurfaceShadow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="PreviousPageButton"
                               Width="24"
                               Height="24"
                               Padding="0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               ToolTip="Previous Page (PageUp)">
                        <ui:SymbolIcon Symbol="ChevronLeft24" FontSize="14" />
                    </ui:Button>

                    <TextBlock x:Name="PageIndicatorText"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Text="1 / 1" />

                    <ui:Button x:Name="NextPageButton"
                               Width="24"
                               Height="24"
                               Padding="0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               ToolTip="Next Page (PageDown)">
                        <ui:SymbolIcon Symbol="ChevronRight24" FontSize="14" />
                    </ui:Button>

                    <Border Width="1"
                            Height="14"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource ControlStrokeColorDefaultBrush}" />

                    <ui:Button x:Name="ResetZoomButton"
                               Height="24"
                               Padding="6,0"
                               CornerRadius="6"
                               Appearance="Transparent"
                               Content="100%"
                               FontSize="12"
                               FontWeight="SemiBold"
                               ToolTip="Reset Zoom (Ctrl+0)" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
